# === Spotify (HIT-4) ===
# https://developer.spotify.com/dashboard — add Redirect URIs for localhost + production
SPOTIFY_CLIENT_ID=
# Optional (PKCE works without it for public clients):
SPOTIFY_CLIENT_SECRET=
# Must match Dashboard exactly:
SPOTIFY_REDIRECT_URI=http://localhost:5173/api/spotify/callback
# Encrypts the Spotify session cookie (defaults to CLIENT_SECRET or CLIENT_ID if unset):
SPOTIFY_COOKIE_SECRET=

# Optional public alias:
# PUBLIC_SPOTIFY_CLIENT_ID=

# === Realtime rooms ===
# Leave empty in local `npm run dev` / Node standalone (same-origin /ws).
# On Vercel (no sticky WS): set to your external WS host, e.g.:
# PUBLIC_WS_URL=wss://spotster-ws.up.railway.app
PUBLIC_WS_URL=

# === Deploy target (build-time) ===
# node = adapter-node + `npm start` (UI+/ws together) — recommended for one public URL
# vercel = adapter-vercel (UI + Spotify API only; requires PUBLIC_WS_URL)
# DEPLOY_TARGET=node
