# === Spotify (HIT-4) ===
# Create an app at https://developer.spotify.com/dashboard
# Redirect URI must match exactly (add in Spotify dashboard too):
SPOTIFY_CLIENT_ID=
# Optional for confidential apps; PKCE works without secret for public clients:
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:5173/api/spotify/callback

# Optional public alias (same value as CLIENT_ID if you prefer PUBLIC_ prefix):
# PUBLIC_SPOTIFY_CLIENT_ID=
