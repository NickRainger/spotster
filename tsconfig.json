{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"ignoreDeprecations": "6.0",
		"types": ["$app/types", "node"],
		"paths": {
			"#lib": ["./src/lib/index.ts"],
			"#lib/*": ["./src/lib/*"],
			"$lib": ["./src/lib/index.ts"],
			"$lib/*": ["./src/lib/*"]
		},
		"baseUrl": "."
	},
	"include": ["src", "server/**/*.ts", "vite.config.ts"],
	"exclude": ["server/**/*.mjs", "build", "node_modules"]
}
